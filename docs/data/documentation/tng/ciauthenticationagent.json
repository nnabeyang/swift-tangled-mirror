{
  "abstract" : [
    {
      "text" : "Keep a restricted Tangled identity available to self-hosted virtual-machine",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "workers without copying its OAuth tokens into a guest. The agent supports a",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "native ",
      "type" : "text"
    },
    {
      "code" : "tng",
      "type" : "codeVoice"
    },
    {
      "text" : " OAuth session or a session issued through an enrolled token-",
      "type" : "text"
    },
    {
      "text" : " ",
      "type" : "text"
    },
    {
      "text" : "mediating backend (TMB). Configure exactly one source for each service.",
      "type" : "text"
    }
  ],
  "hierarchy" : {
    "paths" : [
      [
        "doc:\/\/sh.tngl.nnabeyang.swift-tangled\/documentation\/tng"
      ]
    ]
  },
  "identifier" : {
    "interfaceLanguage" : "swift",
    "url" : "doc:\/\/sh.tngl.nnabeyang.swift-tangled\/documentation\/tng\/CIAuthenticationAgent"
  },
  "kind" : "article",
  "metadata" : {
    "role" : "article",
    "roleHeading" : "Article",
    "title" : "Run the CI authentication agent as a service"
  },
  "primaryContentSections" : [
    {
      "content" : [
        {
          "anchor" : "Enroll-and-sign-in-through-a-TMB",
          "level" : 2,
          "text" : "Enroll and sign in through a TMB",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Obtain a one-time enrollment credential from the TMB administrator and transfer",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "it over a protected channel. On the Mac that runs ",
              "type" : "text"
            },
            {
              "code" : "tng",
              "type" : "codeVoice"
            },
            {
              "text" : ", pass the credential on",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "standard input without placing it in a command argument:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "read -rs TMB_ENROLLMENT",
            "printf '%s' \"$TMB_ENROLLMENT\" | tng auth agent tmb enroll \\",
            "  --origin https:\/\/tmb.example \\",
            "  --name ci-worker \\",
            "  --instance ci-reporting",
            "unset TMB_ENROLLMENT"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "Delete every transferred copy after enrollment succeeds. The named instance is",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "stored below ",
              "type" : "text"
            },
            {
              "code" : "~\/Library\/Application Support\/tng\/tmb\/ci-reporting",
              "type" : "codeVoice"
            },
            {
              "text" : "; its directory",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "and files must remain accessible only to their owner.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Authorize the Tangled account in a browser, then verify a direct authenticated",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "request to its PDS:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "tng auth agent tmb login CI_HANDLE --instance ci-reporting",
            "tng auth agent tmb status --instance ci-reporting",
            "tng auth agent tmb verify --refresh --instance ci-reporting"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "The TMB participates in authorization and refresh. Normal XRPC requests go",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "directly from ",
              "type" : "text"
            },
            {
              "code" : "tng",
              "type" : "codeVoice"
            },
            {
              "text" : " to the account’s PDS with DPoP. The stored access token,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "refresh proof, and DPoP private key never belong in a VM image, job environment,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "log, or LaunchAgent property list.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Install-the-macOS-service",
          "level" : 2,
          "text" : "Install the macOS service",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Install a named per-user LaunchAgent that opens a private Unix socket and uses",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the same TMB instance:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "tng auth agent service install \\",
            "  --tmb-instance ci-reporting \\",
            "  --socket \"\/Users\/ci\/Library\/Application Support\/tng\/ci-agent.sock\" \\",
            "  --profile ci-reporting \\",
            "  --instance ci-reporting"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "The service starts immediately. It starts again after an unexpected exit and",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "when the user logs in after a host restart. FileVault may require an interactive",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "login before a per-user LaunchAgent can run. Pass ",
              "type" : "text"
            },
            {
              "code" : "--executable",
              "type" : "codeVoice"
            },
            {
              "text" : " during",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "installation when ",
              "type" : "text"
            },
            {
              "code" : "tng",
              "type" : "codeVoice"
            },
            {
              "text" : " is not installed at a stable path, and reinstall after",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "moving the executable.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "For a native OAuth session instead, sign in at a private absolute path and use",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "--session-file",
              "type" : "codeVoice"
            },
            {
              "text" : " in place of ",
              "type" : "text"
            },
            {
              "code" : "--tmb-instance",
              "type" : "codeVoice"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "TNG_SESSION_FILE=\"\/Users\/ci\/Library\/Application Support\/tng\/ci-reporting.json\" \\",
            "  tng auth login CI_HANDLE --profile ci-reporting",
            "tng auth agent service install \\",
            "  --session-file \"\/Users\/ci\/Library\/Application Support\/tng\/ci-reporting.json\" \\",
            "  --socket \"\/Users\/ci\/Library\/Application Support\/tng\/ci-agent.sock\" \\",
            "  --profile ci-reporting \\",
            "  --instance ci-reporting"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "Do not combine ",
              "type" : "text"
            },
            {
              "code" : "--session-file",
              "type" : "codeVoice"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "code" : "--tmb-instance",
              "type" : "codeVoice"
            },
            {
              "text" : ". A TMB instance must match",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the service instance when both names are written explicitly.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Operate-and-diagnose-the-service",
          "level" : 2,
          "text" : "Operate and diagnose the service",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Use the same instance for every lifecycle command:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "tng auth agent service status --instance ci-reporting",
            "tng auth agent service restart --instance ci-reporting",
            "tng auth agent service stop --instance ci-reporting",
            "tng auth agent service start --instance ci-reporting",
            "tng auth agent service uninstall --instance ci-reporting"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "Add ",
              "type" : "text"
            },
            {
              "code" : "--json",
              "type" : "codeVoice"
            },
            {
              "text" : " for structured state. Status reports whether the authentication",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "source is ",
              "type" : "text"
            },
            {
              "code" : "native",
              "type" : "codeVoice"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "code" : "tmb",
              "type" : "codeVoice"
            },
            {
              "text" : " and distinguishes an uninstalled or stopped service,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "an invalid or expired session, an unavailable socket, and an incompatible",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "protocol. Account metadata appears only after a successful private-socket probe.",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Standard output and error are stored in",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "~\/Library\/Logs\/tng\/auth-agent\/<instance>\/stdout.log",
              "type" : "codeVoice"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "code" : "stderr.log",
              "type" : "codeVoice"
            },
            {
              "text" : ".",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "Uninstalling preserves these logs and the authentication state.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "If TMB verification fails, stop the service before replacing local state. Check",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the public TMB health endpoint and the named instance with ",
              "type" : "text"
            },
            {
              "code" : "tmb status",
              "type" : "codeVoice"
            },
            {
              "text" : "; then",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "repeat ",
              "type" : "text"
            },
            {
              "code" : "tmb login",
              "type" : "codeVoice"
            },
            {
              "text" : " if only the OAuth session is absent or revoked. Use ",
              "type" : "text"
            },
            {
              "code" : "tmb logout",
              "type" : "codeVoice"
            },
            {
              "text" : " to revoke one session and keep the device enrollment. Use ",
              "type" : "text"
            },
            {
              "code" : "tmb revoke --yes",
              "type" : "codeVoice"
            },
            {
              "text" : " only when retiring or replacing the device, because it revokes every",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "session owned by that device and removes both device and session state.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "If remote logout cannot complete because the authorization server can no",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "longer be discovered, stop the auth-agent first and explicitly discard only",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "the unusable local session:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "tng auth agent tmb logout --instance ci-reporting --local-only --yes"
          ],
          "syntax" : "sh",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "text" : "This recovery operation does not revoke the remote session. Use it only for a",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "session that can no longer authenticate, then run ",
              "type" : "text"
            },
            {
              "code" : "tmb login",
              "type" : "codeVoice"
            },
            {
              "text" : " again. A running",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "auth-agent and an interactive command may share one instance: each request",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "reloads externally rotated state, and conditional replacement prevents a stale",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "process from overwriting a newer refresh or PDS nonce.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Run one named instance with a distinct authentication source and socket for each",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "CI identity. The trusted VM host bridge selects that socket and exposes only",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "TNG_AUTH_AGENT=vsock:\/\/host:10241",
              "type" : "codeVoice"
            },
            {
              "text" : " inside its guest. The agent binds each",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "connection to one job, repository DID, deadline, byte quota, and operation",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "allowlist. The guest never receives the host’s OAuth or TMB state.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "On Linux or when debugging interactively, run ",
              "type" : "text"
            },
            {
              "code" : "tng auth agent serve",
              "type" : "codeVoice"
            },
            {
              "text" : " with",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "--tmb-instance ci-reporting",
              "type" : "codeVoice"
            },
            {
              "text" : ", or set ",
              "type" : "text"
            },
            {
              "code" : "TNG_SESSION_FILE",
              "type" : "codeVoice"
            },
            {
              "text" : " for a native session,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "instead of using the macOS service commands.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
